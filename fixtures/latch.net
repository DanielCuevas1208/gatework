# A level-sensitive latch with transparent, hold, unknown-gate, and reset behavior.
input d
input en
input rst
output q
output nq
wire nq
latch state gate=en d=d q=q init=0 rst=rst
gate NOT observe (q) -> nq
assert q = 0 at 0
assert q = 0 at 2
assert q = 1 at 4
assert q = 0 at 6
assert q = 0 at 10
assert q = x at 12
assert q = 0 at 14
assert q = 1 at 16
assert nq = 1 at 0
assert nq = 0 at 4
assert nq = x at 12
assert nq = 1 at 14
assert nq = 0 at 16
