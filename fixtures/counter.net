# Four-bit synchronous binary counter.
output q0
output q1
output q2
output q3
clock clk period=2

wire d0
wire d1
wire carry2
wire d2
wire carry3
wire d3

gate NOT invert0 (q0) -> d0
gate XOR next1 (q1,q0) -> d1
gate AND carry1 (q1,q0) -> carry2
gate XOR next2 (q2,carry2) -> d2
gate AND carry2 (q2,carry2) -> carry3
gate XOR next3 (q3,carry3) -> d3

dff ff0 clock=clk d=d0 q=q0 init=0
dff ff1 clock=clk d=d1 q=q1 init=0
dff ff2 clock=clk d=d2 q=q2 init=0
dff ff3 clock=clk d=d3 q=q3 init=0
