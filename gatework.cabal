cabal-version:      3.0
name:               gatework
version:            0.12.0.0
synopsis:           Event-driven digital logic simulation in Haskell
description:
  Gatework parses typed netlists, runs combinational gates and D
  flip-flops with an event-driven scheduler, and writes standard VCD
  waveform files. The simulator uses four-state logic: low, high,
  unknown, and floating. Tri-state buffers float their outputs when
  disabled. Several gates can drive one wire, and the scheduler
  resolves the driver values into one wire value. Multi-bit buses use
  bracketed widths and slices. Modules and instances build reusable
  circuits. A module library file stores reusable module definitions.
  The command-line tool loads libraries with the --library option.
  A waveform report command prints the signal values as a text table.
  The command-line tool also sets a whole bus with one bit string.
  Buses render as multi-bit vectors in the VCD timeline.
  GTKWave and other waveform viewers can open the output.
homepage:           https://github.com/DanielCuevas1208/gatework
bug-reports:        https://github.com/DanielCuevas1208/gatework/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Gatework contributors
maintainer:         Gatework contributors
category:           Electronics
build-type:         Simple
extra-source-files:
  fixtures/*.net
  fixtures/*.golden.vcd
  fixtures/*.golden.report
extra-doc-files:
  README.md
  CHANGELOG.md
tested-with:        GHC ==9.6.*

source-repository head
  type:                git
  location:            https://github.com/DanielCuevas1208/gatework.git

common common-options
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
  import:            common-options
  hs-source-dirs:    src
  exposed-modules:
      Gatework.Logic
      Gatework.Netlist
      Gatework.Report
      Gatework.Simulator
      Gatework.VCD
  other-modules:
      Paths_gatework
  autogen-modules:
      Paths_gatework
  build-depends:
      base >=4.14 && <5,
      containers >=0.6 && <0.8

executable gatework
  import:            common-options
  hs-source-dirs:    app
  main-is:           Main.hs
  build-depends:
      base >=4.14 && <5,
      gatework

test-suite gatework-test
  import:            common-options
  type:              exitcode-stdio-1.0
  hs-source-dirs:    test
  main-is:           Spec.hs
  build-depends:
      base >=4.14 && <5,
      containers >=0.6 && <0.8,
      gatework,
      QuickCheck >=2.14 && <3
